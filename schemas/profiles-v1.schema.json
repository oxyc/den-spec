{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oxyc/den-spec/schemas/profiles-v1.schema.json",
  "title": "Den household profiles v1",
  "oneOf": [
    {"$ref": "#/$defs/directory"},
    {"$ref": "#/$defs/titleApprovals"},
    {"$ref": "#/$defs/selection"}
  ],
  "$defs": {
    "profileId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "stamp": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        {"type": "string", "pattern": "^(|[0-9a-f]{16})$"}
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "displayValue": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 64},
        "avatar": {"type": "string", "pattern": "^[0-9A-Za-z_-]{1,64}$"}
      },
      "additionalProperties": true
    },
    "libraryValue": {
      "type": "object",
      "required": ["keyVersion", "key"],
      "properties": {
        "keyVersion": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "key": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4}){10}[A-Za-z0-9+/]{3}=$"
        }
      },
      "additionalProperties": false
    },
    "policyValue": {
      "type": "object",
      "required": ["maximumAge", "unknownRatings"],
      "properties": {
        "maximumAge": {"type": ["integer", "null"], "minimum": 0, "maximum": 18},
        "unknownRatings": {"enum": ["allow", "block"]}
      },
      "additionalProperties": true
    },
    "stampedDisplay": {
      "type": "object",
      "required": ["value", "at"],
      "properties": {"value": {"$ref": "#/$defs/displayValue"}, "at": {"$ref": "#/$defs/stamp"}},
      "additionalProperties": false
    },
    "stampedLibrary": {
      "type": "object",
      "required": ["value", "at"],
      "properties": {"value": {"$ref": "#/$defs/libraryValue"}, "at": {"$ref": "#/$defs/stamp"}},
      "additionalProperties": false
    },
    "stampedPolicy": {
      "type": "object",
      "required": ["value", "at"],
      "properties": {"value": {"$ref": "#/$defs/policyValue"}, "at": {"$ref": "#/$defs/stamp"}},
      "additionalProperties": false
    },
    "stampedDeleted": {
      "type": "object",
      "required": ["value", "at"],
      "properties": {"value": {"type": "boolean"}, "at": {"$ref": "#/$defs/stamp"}},
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": ["id", "role", "display", "library", "policy", "deleted"],
      "properties": {
        "id": {"$ref": "#/$defs/profileId"},
        "role": {"enum": ["owner", "adult", "kid"]},
        "display": {"$ref": "#/$defs/stampedDisplay"},
        "library": {"$ref": "#/$defs/stampedLibrary"},
        "policy": {"$ref": "#/$defs/stampedPolicy"},
        "deleted": {"$ref": "#/$defs/stampedDeleted"}
      },
      "additionalProperties": true
    },
    "directory": {
      "type": "object",
      "required": ["format", "kind", "schema", "owner", "profiles"],
      "properties": {
        "format": {"const": 4},
        "kind": {"const": "profiles"},
        "schema": {"const": 1},
        "owner": {"$ref": "#/$defs/profileId"},
        "profiles": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/profileId"},
          "additionalProperties": {"$ref": "#/$defs/entry"},
          "minProperties": 1
        }
      },
      "additionalProperties": true
    },
    "titleKey": {
      "type": "string",
      "pattern": "^(movie|tv):(?:[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[01][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[01][0-9]{2}|42949672[0-8][0-9]|429496729[0-5])$"
    },
    "stampedApproval": {
      "type": "object",
      "required": ["value", "at"],
      "properties": {
        "value": {"enum": ["allow", "tombstone"]},
        "at": {"$ref": "#/$defs/stamp"}
      },
      "additionalProperties": true
    },
    "titleApprovals": {
      "type": "object",
      "required": ["format", "kind", "schema", "kid", "approvals"],
      "properties": {
        "format": {"const": 4},
        "kind": {"const": "kid-title-approvals"},
        "schema": {"const": 1},
        "kid": {"$ref": "#/$defs/profileId"},
        "approvals": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/titleKey"},
          "additionalProperties": {"$ref": "#/$defs/stampedApproval"}
        }
      },
      "additionalProperties": true
    },
    "selection": {
      "oneOf": [
        {
          "type": "object",
          "required": ["version", "mode", "profileId"],
          "properties": {
            "version": {"const": 1},
            "mode": {"const": "persistent"},
            "profileId": {"$ref": "#/$defs/profileId"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["version", "mode", "visitorNamespace"],
          "properties": {
            "version": {"const": 1},
            "mode": {"const": "visitor"},
            "visitorNamespace": {"$ref": "#/$defs/profileId"}
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
