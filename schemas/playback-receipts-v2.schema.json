{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oxyc/den-spec/schemas/playback-receipts-v2.schema.json",
  "title": "Den profile-routed playback receipts v2 proof wrapper",
  "$ref": "#/$defs/wrapper",
  "$defs": {
    "exactUint": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "x-den-exactInteger": "JSON token must use 0|[1-9][0-9]*; reject booleans, -0, decimal points and exponents before coercion"
    },
    "exactPositiveUint": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "x-den-exactInteger": "JSON token must use [1-9][0-9]*; reject booleans, decimal points and exponents before coercion"
    },
    "hex16": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "hex32": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base64url32": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "proof": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "xwingPublic": {
      "type": "string",
      "minLength": 1622,
      "maxLength": 1622,
      "pattern": "^[A-Za-z0-9_-]{1622}$",
      "x-den-decodedLength": 1216
    },
    "operationBase": {
      "type": "object",
      "required": ["v", "op", "household", "route", "binding", "generation", "issuedAt", "nonce"],
      "properties": {
        "v": {"const": 2, "x-den-exactInteger": true},
        "op": {"type": "string"},
        "household": {"$ref": "#/$defs/hex16"},
        "route": {"$ref": "#/$defs/hex16"},
        "binding": {"$ref": "#/$defs/hex16"},
        "generation": {"$ref": "#/$defs/exactPositiveUint"},
        "issuedAt": {"$ref": "#/$defs/exactUint"},
        "nonce": {"$ref": "#/$defs/hex16"}
      }
    },
    "operation": {
      "allOf": [
        {"$ref": "#/$defs/operationBase"},
        {
          "oneOf": [
            {
              "properties": {
                "op": {"const": "register"},
                "activity": {"$ref": "#/$defs/hex16"},
                "kid": {"$ref": "#/$defs/hex16"},
                "public": {"$ref": "#/$defs/xwingPublic"}
              },
              "required": ["activity", "kid", "public"]
            },
            {
              "properties": {
                "op": {"const": "rebind"},
                "previousActivity": {"$ref": "#/$defs/hex16"},
                "activity": {"$ref": "#/$defs/hex16"}
              },
              "required": ["previousActivity", "activity"]
            },
            {
              "properties": {
                "op": {"const": "rotate"},
                "kid": {"$ref": "#/$defs/hex16"},
                "public": {"$ref": "#/$defs/xwingPublic"}
              },
              "required": ["kid", "public"]
            },
            {"properties": {"op": {"const": "revoke"}}},
            {
              "properties": {"op": {"const": "playback"}, "request": {"$ref": "#/$defs/hex32"}},
              "required": ["request"]
            },
            {"properties": {"op": {"const": "drain"}}},
            {
              "properties": {"op": {"const": "ack"}, "upTo": {"$ref": "#/$defs/exactPositiveUint"}},
              "required": ["upTo"]
            },
            {"properties": {"op": {"const": "activate"}}}
          ]
        }
      ],
      "unevaluatedProperties": false,
      "x-den-kidRelation": "For register/rotate, kid is lowercase hex(SHA-256(decoded public)[0..16])"
    },
    "wrapper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "operation", "proof"],
      "properties": {
        "authority": {"$ref": "#/$defs/base64url32"},
        "operation": {"$ref": "#/$defs/operation"},
        "proof": {"$ref": "#/$defs/proof"}
      }
    },
    "drainEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "id", "kid", "sealed", "seq"],
      "properties": {
        "generation": {"$ref": "#/$defs/exactPositiveUint"},
        "id": {"$ref": "#/$defs/hex16"},
        "kid": {"$ref": "#/$defs/hex16"},
        "sealed": {"type": "string", "minLength": 1, "maxLength": 2539, "pattern": "^[A-Za-z0-9_-]+$"},
        "seq": {"$ref": "#/$defs/exactPositiveUint"}
      }
    },
    "drainResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "route", "binding", "messages"],
      "properties": {
        "v": {"const": 2, "x-den-exactInteger": true},
        "route": {"$ref": "#/$defs/hex16"},
        "binding": {"$ref": "#/$defs/hex16"},
        "messages": {"type": "array", "maxItems": 25, "items": {"$ref": "#/$defs/drainEntry"}}
      }
    },
    "aad": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "household", "route", "binding", "generation", "kid", "id"],
      "properties": {
        "v": {"const": 2, "x-den-exactInteger": true},
        "household": {"$ref": "#/$defs/hex16"},
        "route": {"$ref": "#/$defs/hex16"},
        "binding": {"$ref": "#/$defs/hex16"},
        "generation": {"$ref": "#/$defs/exactPositiveUint"},
        "kid": {"$ref": "#/$defs/hex16"},
        "id": {"$ref": "#/$defs/hex16"}
      }
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": {"$ref": "#/$defs/exactPositiveUint"},
        "type": {"enum": ["movie", "tv"]}
      }
    },
    "receiptBase": {
      "type": "object",
      "required": ["v", "household", "route", "binding", "generation", "kid", "id", "title", "positionSeconds", "durationSeconds", "completed", "endedAt", "expiresAt"],
      "properties": {
        "v": {"const": 2, "x-den-exactInteger": true},
        "household": {"$ref": "#/$defs/hex16"},
        "route": {"$ref": "#/$defs/hex16"},
        "binding": {"$ref": "#/$defs/hex16"},
        "generation": {"$ref": "#/$defs/exactPositiveUint"},
        "kid": {"$ref": "#/$defs/hex16"},
        "id": {"$ref": "#/$defs/hex16"},
        "title": {"$ref": "#/$defs/title"},
        "positionSeconds": {"$ref": "#/$defs/exactUint"},
        "durationSeconds": {"$ref": "#/$defs/exactPositiveUint"},
        "completed": {"type": "boolean"},
        "endedAt": {"$ref": "#/$defs/exactUint"},
        "expiresAt": {"$ref": "#/$defs/exactUint"}
      }
    },
    "receipt": {
      "allOf": [
        {"$ref": "#/$defs/receiptBase"},
        {
          "oneOf": [
            {
              "properties": {"title": {"properties": {"type": {"const": "movie"}}}}
            },
            {
              "properties": {
                "title": {"properties": {"type": {"const": "tv"}}},
                "season": {"type": "integer", "minimum": 0, "maximum": 9999, "x-den-exactInteger": true},
                "episode": {"type": "integer", "minimum": 1, "maximum": 99999, "x-den-exactInteger": true}
              },
              "required": ["season", "episode"]
            }
          ]
        }
      ],
      "unevaluatedProperties": false,
      "x-den-relations": [
        "positionSeconds <= durationSeconds",
        "expiresAt = endedAt + 604800000 without safe-integer overflow",
        "AAD and plaintext v/household/route/binding/generation/kid/id are equal"
      ]
    }
  }
}
